# Reference only. Set variables in the shell or secret manager.
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Private sandbox. Never use live-mode credentials.
BARA_STRIPE_SANDBOX_ENABLED=false
BARA_STRIPE_TEST_KEY=
BARA_STRIPE_WEBHOOK_SECRET=
BARA_STRIPE_API_VERSION=2025-02-24.acacia
BARA_BILLING_BASE_URL=http://127.0.0.1:8000

# Private PostgreSQL. Blank name selects local SQLite.
BARA_DB_NAME=
BARA_DB_HOST=localhost
BARA_DB_PORT=5432
BARA_DB_USER=
BARA_DB_PASSWORD=
BARA_DB_SSLMODE=verify-full
BARA_SUPABASE_PROJECT_REF=
BARA_SUPABASE_MANAGEMENT_TOKEN=
BARA_SUPABASE_AUTO_RESUME=false

# Transactional email. Default runs simulate delivery.
BARA_REPORTS_LIVE_EMAIL=false
BARA_REPORTS_FROM_EMAIL=
BARA_REPORTS_SENDER_DOMAIN=
BARA_RESEND_API_KEY=
BARA_RESEND_WEBHOOK_SECRET=

# Public build metadata. Configure in Actions Variables when deploying Pages.
BARA_GA_MEASUREMENT_ID=
BARA_GOOGLE_SITE_VERIFICATION=
BARA_GOOGLE_BOOKING_URL=
